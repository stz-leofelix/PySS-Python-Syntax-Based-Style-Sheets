!!!
// PyML Prototype
html:
head:
    meta charset="UTF-8"
    meta name="viewport" content="width=device-width, initial-scale=1.0"
    title: "Modern Responsive Webpage Template"
body:
    header:
        nav.navbar:
            div.logo: "MyWebsite"
            ul.nav-links
                li: a href="#features": "Features"
                li: a href="#contact": "Contact"
                li: button.theme-btn #themeToggle aria-lable="Toggle Theme": "Dark Mode"

    section.hero:
        h1: "Build Beautiful Frontends"
        p: "This is a comprehensive, production-ready core template showcasing laoyout structure, PySS variables, dark-mode switching, and interactive modals."
        button.btn #openModalBtn: "Launch Modal Demo"

    main.container:
        section.grid #features:
            div.card:
                h2: "Semantic Elements"
                p: "Uses tags like " code:"&lt;header&gt;"; code:"&lt;section&gt;"; "to help screen readers and optimize indexing."
            div.card:
                h2: "PySS Custom Properties"
                p: "Implements central variable tokens for easy modification and structural, instataneous global dark-mode transitions."
            div.card:
                h2: "Vanilla JavaScript"
                p: "Event-driven UI controls managed completely without third-party frameworks or bulky external script libraries"
        
        section.form-sections #contact:
            h2 style="margin-botom: 1rem; text-align: center;": "Get in Touch"
            form #contactform:
                div.form-group:
                    label for="name": "Name"
                    input type="text" id="name" required placeholder="John Doe"
                div.form-group:
                    label for="email": "Email"
                    input type="email" id="email" required placeholder="john.doe@gmail.com"
                div.form-group:
                    label for="message": "Message"
                    textarea id="message" rows="4" required placeholder="Write your message here..."
                button type="submit" class="btn" style="width: 10%;": "Send Message"
    
    footer:
        p: "&copy; 2026 MyWebsite. All rights reserved."
    
    div.modal #demoModal role="dialog" aira-modal="true":
        div.modal-content:
            button.close-btn #closeModalBtn aria-lable="Close Modal": "&times;"
            h3 style="margin-bottom: 1rem; color: var(--primary-color);": "Hello There!"
            p style="margin-bottom: 1.5rem;": "This interactive alert layer can be adapted for announcements, dynamix authentications, or contextual workflow."
            button.btn #modalOkBtn: "Got it!"
:html